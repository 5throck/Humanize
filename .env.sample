# Humanize — LLM 설정 (.env)
# 이 파일을 .env로 복사하거나 이름을 .env로 바꿔 값만 채우세요.
# serve.ts가 읽으며, 브라우저로 키 값이 전송되지 않습니다 (프록시가 주입).
# .env에 값이 있으면 설정창의 브라우저 저장 설정보다 우선합니다.
#
# 적용하려면 서버 재시작이 필요합니다:  bun serve.ts   (또는 node serve.ts)

# ── 공급자 선택 — 이것 하나로 Base URL·인증 방식이 자동으로 정해집니다.
#    openai-compatible | anthropic | gemini | custom
#    편의 프리셋: zai | zai-coding | openai | deepseek | bigmodel
#    none: 서버 키 주입 비활성 (브라우저에 저장한 키만 사용)
#
#    각 값의 기본 동작:
#      openai-compatible → https://api.openai.com/v1 + LLM_API_KEY
#      anthropic         → https://api.anthropic.com + LLM_API_KEY (Messages API 변환)
#      gemini            → https://generativelanguage.googleapis.com/v1beta
#                          + LLM_API_KEY (generateContent 변환)
#      custom            → LLM_BASE_URL 필수 + LLM_API_KEY (OpenAI 호환 임의 엔드포인트)
LLM_PROVIDER=openai-compatible

# ── API 키 — 선택한 공급자의 키 (공급자별 이름도 인식합니다:
#    OPENAI_API_KEY / ANTHROPIC_API_KEY / GEMINI_API_KEY·GOOGLE_API_KEY /
#    ZAI_API_KEY / DEEPSEEK_API_KEY)
LLM_API_KEY=

# ── 모델. 공급자별 모델 ID:
#   OpenAI:    gpt-4.1, gpt-4.1-mini
#   Anthropic: claude-sonnet-4-5, claude-haiku-4-5
#   Gemini:    gemini-2.5-flash, gemini-2.5-pro
#   GLM:       glm-5.3, glm-5.3-flash, glm-4.6 (소문자)
#   DeepSeek:  deepseek-chat, deepseek-reasoner
LLM_MODEL=gpt-4.1-mini

# ── Base URL (선택) — 공급자 기본 주소를 쓰면 생략됩니다. 공식 URL을 그대로 쓰세요:
# LLM_BASE_URL=https://api.openai.com/v1
